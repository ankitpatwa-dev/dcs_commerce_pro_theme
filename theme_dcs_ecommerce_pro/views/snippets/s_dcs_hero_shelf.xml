<odoo>

    <!--
        Shelf hero: copy on the left, the product standing in a tinted image
        well on the right, with a tag-shaped label. Standard section > container
        > row markup so Odoo's background, colour, spacing, column and
        animation options all apply.
    -->
    <template id="s_dcs_hero_shelf" name="Shelf Hero">
        <section class="s_dcs_hero_shelf o_cc o_cc1 pt56 pb56" data-vcss="001" data-snippet="s_dcs_hero_shelf" data-name="Shelf Hero">
            <div class="container">
                <div class="row align-items-center gx-4 gx-lg-5 gy-5">
                    <div class="col-lg-6 o_dcs_hero_copy">
                        <h1 class="o_dcs_hero_title">New in this week</h1>
                        <p class="lead o_dcs_hero_lead">Pieces chosen for everyday use. Order before 2 pm and it ships the same day.</p>
                        <p class="o_dcs_hero_actions mb-0">
                            <a href="/shop" class="btn btn-primary btn-lg">Shop new arrivals</a>
                            <a href="/shop" class="btn btn-outline-secondary btn-lg">Browse categories</a>
                        </p>
                    </div>
                    <div class="col-lg-6">
                        <figure class="o_dcs_well mb-0">
                            <img src="/web/image/website.s_picture_default_image" class="img-fluid o_dcs_well_img" alt="Featured product" loading="eager" width="800" height="600"/>
                            <figcaption class="o_dcs_tag">Just in</figcaption>
                        </figure>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
